   27  journalctl -u nginx -b
   28  journalctl -u nginx -b > ~/journalctl.out
   29  mkdir -p /data/mephi-2026
   30  groupadd -g 4444 curators
   31  groupadd -g 4445 mephi-dev
   32  useradd -u 5501 -G mephi-dev user1
   33  useradd -u 5502 -G mephi-dev user2
   34  useradd -u 5503 -G mephi-dev user3
   35  useradd -u 5504 -G curators curator1
   36  useradd -u 5505 -G curators curator2
   37  passwd user1
   38  passwd user2
   39  passwd user3
   40  passwd curator1
   41  passwd curator2
   42  chown root:mephi-dev /data/mephi-2026
   43  chmod 2770 /data/mephi-2026
   44  setfacl -m g:curators:r-X /data/mephi-2026
   45  setfacl -d -m g:curators:r-X /data/mephi-2026
   46  setcap cap_net_raw,cap_net_admin=eip /usr/sbin/tcpdump
