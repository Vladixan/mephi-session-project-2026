   51  vi /etc/selinux/targeted/contexts/files/file_contexts.local
   52  restorecon -Rv /mephi-web
   53  systemctl restart nginx
   54  curl http://localhost
   55  vi /etc/security/access.conf
   56  vi /etc/security/pwquality.conf
   57  chage -M 90 user1
   58  chage -M 90 user2 [B
   59  chage -M 90 user3
   60  chage -M 90 curator1
   61  chage -M 90 curator2
   62  cat /mephi-web/index.html
   63  curl http://localhost
   64  history > ~/history.out
   65  ls
   66  stat /data/mephi-2026 > ~/stat.out
   67  stat /data/mephi-2026
   68  getenforce
   69  getenforce > ~/getenforce.out
   70  stat /mephi-web
   71  stat /mephi-web >> stat.out
   72  curl http://localhost/ > ~/curl.out
   73  cat curl.out
   74  lsblk
   75  cat history.out
   76  lsblk
   77  cd /mnt
   78  ls
   79  cd ~/
   80  ls
