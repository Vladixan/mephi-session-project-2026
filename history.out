    1  hostnamectl set-hostname mephi-2026.domain.local
    2  hostnamectl
    3  vi /etc/hosts
    4  exec bash
    5  hostname -f
    6  ping -c 4 8.8.8.8
    7  ping -c 4 8.8.8.8 > ~/ping.out
    8  dnf install -y nginx
    9  dnf update -y
   10  dnf install -y libcap-ng-utils
   11  dnf download --resolve tcpdump --destdir=/tmp
